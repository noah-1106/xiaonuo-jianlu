# LLM（OpenAI Chat Completions 兼容格式，豆包/DeepSeek/通义/OpenAI 均可）
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=your-api-key
LLM_MODEL=doubao-seed-1-8-251228

# ASR（OpenAI Audio 兼容格式，OpenAI Whisper / Groq / 硅基流动等）
# ASR_BASE_URL=https://api.openai.com/v1
# ASR_API_KEY=your-asr-key
# ASR_MODEL=whisper-1
# 端点路径可配：OpenAI 系默认 /audio/transcriptions，MiniMax 用 /speech_to_text + model=asr-1.0
# ASR_PATH=/audio/transcriptions

# 服务
PORT=3000
# 数据库文件路径（默认 ./data/xiaonuo.db）
# DB_PATH=./data/xiaonuo.db

# 开发：设为 1 使用内置 mock（不消耗 API，固定走 createRecord 流程）
# MOCK_LLM=1
# MOCK_ASR=1
